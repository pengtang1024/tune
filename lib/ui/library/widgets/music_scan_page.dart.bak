import 'package:flutter/material.dart';
import 'package:tune/core/extension/theme_extension.dart';

class ScanProgressWidget extends StatelessWidget {
  final bool isScanning;
  final int totalCount;
  final int scannedCount;

  const ScanProgressWidget({
    super.key,
    required this.isScanning,
    required this.totalCount,
    required this.scannedCount,
  });

  @override
  Widget build(BuildContext context) {
    if (!isScanning || totalCount == 0) return const SizedBox.shrink();

    return Column(
      children: [
        LinearProgressIndicator(
          value: scannedCount / totalCount,
          backgroundColor: context.theme.colorScheme.surfaceContainerHighest,
        ),
        Padding(
          padding: const EdgeInsets.only(top: 4.0),
          child: Text(
            '已扫描 $scannedCount / $totalCount 首歌曲',
            style: const TextStyle(fontSize: 12),
          ),
        ),
      ],
    );
  }
}
import 'package:flutter/material.dart';

class ScanStatusWidget extends StatelessWidget {
  final String statusMessage;
  final String errorMessage;

  const ScanStatusWidget({
    super.key,
    required this.statusMessage,
    required this.errorMessage,
  });

  @override
  Widget build(BuildContext context) {
    if (statusMessage.isEmpty) return const SizedBox.shrink();

    return Padding(
      padding: const EdgeInsets.only(top: 8.0),
      child: Text(
        statusMessage,
        style: TextStyle(
          color: errorMessage.isEmpty ? Colors.blue : Colors.red,
        ),
      ),
    );
  }
}
import 'package:flutter/material.dart';

class ScanButtonWidget extends StatelessWidget {
  final bool isScanning;
  final VoidCallback onPressed;

  const ScanButtonWidget({
    super.key,
    required this.isScanning,
    required this.onPressed,
  });

  @override
  Widget build(BuildContext context) {
    return Row(
      children: [
        Expanded(
          child: ElevatedButton.icon(
            onPressed: isScanning ? null : onPressed,
            icon: isScanning
                ? const SizedBox(
                    width: 16,
                    height: 16,
                    child: CircularProgressIndicator(strokeWidth: 2),
                  )
                : const Icon(Icons.search),
            label: Text(isScanning ? '扫描中...' : '开始扫描'),
          ),
        ),
      ],
    );
  }
}

class MusicScanPage extends ConsumerStatefulWidget {
  const MusicScanPage({super.key});

  @override
  ConsumerState<MusicScanPage> createState() => _MusicScanPageState();
}

class _MusicScanPageState extends ConsumerState<MusicScanPage> {
  // 页面状态变量
  bool _isLoadingPaths = false;
  List<String> _customScanPaths = [];
  bool _isScanning = false;
  int _scannedCount = 0;
  int _totalCount = 0;
  List<Song> _songs = [];
  String _statusMessage = '';
  String _errorMessage = '';

  @override
  void initState() {
    super.initState();
    _loadCustomScanPaths();
  }

  Future<void> _loadCustomScanPaths() async {
    setState(() {
      _isLoadingPaths = true;
    });

    try {
      final persistenceService = ref.read(sharedPreferencesServiceProvider);
      final paths = persistenceService.getStringList('custom_scan_paths') ?? [];

      setState(() {
        _customScanPaths = paths;
        _isLoadingPaths = false;
      });
    } catch (e) {
      Log.info('MusicScanPage: Failed to load custom scan paths: $e');
      setState(() {
        _isLoadingPaths = false;
      });
    }
  }

  Future<void> _saveCustomScanPaths() async {
    try {
      final persistenceService = ref.read(sharedPreferencesServiceProvider);
      await persistenceService.setStringList('custom_scan_paths', _customScanPaths);
    } catch (e) {
      Log.info('MusicScanPage: Failed to save custom scan paths: $e');
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('保存扫描路径失败: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  Future<void> _addCustomScanPath() async {
    try {
      final result = await FilePicker.platform.getDirectoryPath();
      if (result != null) {
        setState(() {
          if (!_customScanPaths.contains(result)) {
            _customScanPaths.add(result);
            _saveCustomScanPaths();
          }
        });

        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text('已添加自定义扫描路径'),
            ),
          );
        }
      }
    } catch (e) {
      Log.info('MusicScanPage: Failed to add custom scan path: $e');
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('添加扫描路径失败: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  void _removeCustomScanPath(int index) {
    setState(() {
      _customScanPaths.removeAt(index);
      _saveCustomScanPaths();
    });

    if (mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('已移除扫描路径'),
        ),
      );
    }
  }

  Future<void> _scanCustomPaths() async {
    if (_isScanning || _customScanPaths.isEmpty) return;

    await _startScan();
  }

  // 开始扫描音乐
  Future<void> _startScan() async {
    if (_isScanning) return;

    setState(() {
      _isScanning = true;
      _scannedCount = 0;
      _totalCount = 0;
      _songs = [];
      _statusMessage = '开始扫描音乐库...';
      _errorMessage = '';
    });

    try {
      Log.info('MusicScanPage: Starting music scan');
      // 使用跨平台音乐扫描服务替代原来的平台音乐服务
      final crossPlatformScanner = ref.read(crossPlatformMusicScannerProvider);

      // 显示扫描开始信息
      setState(() {
        _statusMessage = '正在扫描音乐文件...';
      });

      // 获取所有歌曲
      List<Song> songs;
      if (_customScanPaths.isNotEmpty) {
        // 如果有自定义扫描路径，则扫描这些路径
        Log.info('MusicScanPage: Scanning custom paths: $_customScanPaths');
        songs = await crossPlatformScanner.scanMusicInDirectories(_customScanPaths);
      } else {
        // 否则执行全平台扫描
        Log.info('MusicScanPage: Performing cross-platform scan');
        songs = await crossPlatformScanner.scanMusic();
      }

      setState(() {
        _songs = songs;
        _scannedCount = songs.length;
        _totalCount = songs.length;
        _statusMessage = '扫描完成';
        _isScanning = false;
      });

      Log.info('MusicScanPage: Scan completed, found ${songs.length} songs');

      // 显示扫描结果
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('扫描完成，共找到 $_scannedCount 首歌曲'),
            duration: const Duration(seconds: 2),
          ),
        );
      }
    } catch (e) {
      Log.info('MusicScanPage: Scan failed with error: $e');
      String errorMessage = '扫描失败';

      // 检查是否为MissingPluginException
      if (e.toString().contains('MissingPluginException')) {
        errorMessage = '当前平台不支持音乐扫描功能。此功能仅在Android和iOS设备上可用。';
      } else if (e.toString().contains('Permission denied')) {
        errorMessage = '没有音乐库访问权限，请在设置中授予相关权限。';
      } else {
        errorMessage = '扫描失败: ${e.toString()}';
      }

      setState(() {
        _isScanning = false;
        _errorMessage = errorMessage;
        _statusMessage = '扫描失败';
      });

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('扫描失败，请查看日志了解详情'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    ref.watch(libraryStateNotifierProvider);

    return Scaffold(
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: SingleChildScrollView(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Card(
                child: Padding(
                  padding: const EdgeInsets.all(16.0),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const ScanHeaderWidget(),
                      const SizedBox(height: 16),
                      ScanButtonWidget(
                        isScanning: _isScanning,
                        onPressed: _startScan,
                      ),
                      const SizedBox(height: 8),
                      ScanStatusWidget(
                        statusMessage: _statusMessage,
                        errorMessage: _errorMessage,
                      ),
                      ScanProgressWidget(
                        isScanning: _isScanning,
                        totalCount: _totalCount,
                        scannedCount: _scannedCount,
                      ),
                    ],
                  ),
                ),
              ),

              const SizedBox(height: 16),

              // 自定义扫描路径
              Card(
                child: Padding(
                  padding: const EdgeInsets.all(16.0),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      CustomPathsHeaderWidget(onAddPath: _addCustomScanPath),
                      const CustomPathsDescriptionWidget(),
                      const SizedBox(height: 16),
                      if (_isLoadingPaths)
                        const Center(child: CircularProgressIndicator())
                      else if (_customScanPaths.isEmpty)
                        const Text('暂无自定义扫描路径')
                      else
                        ListView.builder(
                          shrinkWrap: true,
                          physics: const NeverScrollableScrollPhysics(),
                          itemCount: _customScanPaths.length,
                          itemBuilder: (context, index) {
                            final path = _customScanPaths[index];
                            return CustomPathListItemWidget(
                              path: path,
                              onDelete: () => _removeCustomScanPath(index),
                            );
                          },
                        ),
                      const SizedBox(height: 16),
                      if (_customScanPaths.isNotEmpty)
                        CustomPathsScanButtonWidget(
                          isScanning: _isScanning,
                          hasCustomPaths: _customScanPaths.isNotEmpty,
                          onPressed: _scanCustomPaths,
                        ),
                    ],
                  ),
                ),
              ),

              const SizedBox(height: 16),

              // 扫描结果
              if (!_isScanning && _songs.isNotEmpty) ...[
                ScanResultsHeaderWidget(scannedCount: _scannedCount),
                const SizedBox(height: 8),
                SizedBox(
                  height: 300,
                  child: ListView.builder(
                    itemCount: _songs.length,
                    itemBuilder: (context, index) {
                      final song = _songs[index];
                      return SongListItemWidget(
                        song: song,
                        durationText: _formatDuration(song.duration),
                      );
                    },
                  ),
                ),
              ] else if (_errorMessage.isNotEmpty) ...[
                ErrorStateWidget(
                  errorMessage: _errorMessage,
                  onRetry: _startScan,
                ),
              ] else if (!_isScanning && _statusMessage.isNotEmpty && _songs.isEmpty) ...[
                const Center(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      Icon(
                        Icons.music_off,
                        size: 48,
                        color: Colors.grey,
                      ),
                      SizedBox(height: 16),
                      Text(
                        '未找到音乐文件\n点击"开始扫描"按钮扫描本地音乐',
                        textAlign: TextAlign.center,
                        style: TextStyle(
                          fontSize: 16,
                          color: Colors.grey,
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }

  /// 格式化歌曲时长显示
  String _formatDuration(int durationMs) {
    final Duration duration = Duration(milliseconds: durationMs);
    final int minutes = duration.inMinutes;
    final int seconds = duration.inSeconds.remainder(60);
    return '$minutes:${seconds.toString().padLeft(2, '0')}';
  }
}
