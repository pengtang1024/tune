# 统一按文本处理，让 git 自己判断换行（不强制 eol，避免历史文件被整体重写）
* text=auto

# 生成产物：不在 GitHub 语言统计里占份额，diff 视图默认折叠
lib/l10n/app_localizations*.dart linguist-generated=true
*.g.dart linguist-generated=true
pubspec.lock linguist-generated=true -diff

# 二进制：不做文本 diff，不参与行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.gguf binary
*.onnx binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.mp3 binary
*.flac binary
*.m4a binary
*.wav binary
*.mp4 binary

# 归档与构建产物
/dist/ export-ignore
*.tar.gz binary
